{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/*.gen.ts",
    "apps/api/src/shared/db/createDatabase.ts",
    "apps/api/src/shared/db/withFamilyScope.ts"
  ],
  "workspaces": {
    ".": {
      "entry": ["tooling/**/*.test.ts", "scripts/**/*.test.ts", "scripts/heic-spike/measureOne.ts"],
      "project": ["tooling/**/*.ts", "scripts/**/*.ts"]
    },
    "apps/api": {
      "entry": ["src/server.ts!", "src/shared/db/migrate.ts!"],
      "project": ["src/**/*.ts!", "!src/shared/test/**!", "scripts/**/*.ts"]
    },
    "apps/worker": {
      "entry": ["src/worker.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "apps/web": {
      "entry": ["src/app/routes/**/*.tsx!"],
      "project": ["src/**/*.{ts,tsx,css}!"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts!"]
    }
  }
}

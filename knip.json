{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["**/*.gen.ts"],
  "workspaces": {
    ".": {
      "entry": [
        "tooling/**/*.test.ts",
        "scripts/**/*.test.ts",
        "scripts/heic-spike/measureOne.ts",
        "scripts/spike/identityProvider.ts!",
        "scripts/spike/identityMeasurements.ts!",
        "e2e/**/*.spec.ts"
      ],
      "project": ["tooling/**/*.ts", "scripts/**/*.ts", "e2e/**/*.ts"]
    },
    "apps/api": {
      "entry": ["src/{server,shared/db/migrate}.ts!"],
      "project": [
        "src/**/*.ts!",
        "!src/shared/test/**!",
        "scripts/**/*.ts",
        "!src/features/painJournal/application/painIssueTestFixture.ts!",
        "!src/features/painJournal/infrastructure/painRepositoryFixture.ts!",
        "!src/features/painJournal/infrastructure/waitForPainLocks.ts!",
        "!src/features/painJournal/presentation/painJournalHttpFixture.ts!",
        "!src/features/painJournal/presentation/painJournalScenario.ts!"
      ]
    },
    "apps/worker": {
      "entry": ["src/{worker,features/documentSanitize/infrastructure/sanitizeJpegChild}.ts!"],
      "project": ["src/**/*.ts!", "!src/shared/test/**!", "!src/**/*.test-helper.ts!"]
    },
    "apps/web": {
      "entry": [
        "src/app/routes/**/*.tsx!",
        "e2e/bodyMap2DHarness.tsx",
        "e2e/newPainIssueHarness.tsx",
        "e2e/quickPainEntryHarness.tsx",
        "e2e/painIssueDetailHarness.tsx",
        "e2e/themeHarness.tsx",
        "e2e/**/*.spec.ts",
        "vite.body-map.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}!",
        "!src/**/*.test-helper.ts!",
        "!src/features/scanQuota/test/**!",
        "e2e/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": ["@fontsource/be-vietnam-pro", "@fontsource/newsreader"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts!"]
    },
    "packages/web-push": {
      "project": ["src/**/*.ts!"],
      "ignoreDependencies": ["web-push"]
    }
  }
}

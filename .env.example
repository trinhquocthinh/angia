# =============================================================================
# AN GIA — mẫu biến môi trường (10-setup-and-ops-guide §3)
# Sao chép: cp .env.example .env
# Giá trị dưới đây CHỈ dành cho cụm dev cục bộ (docker-compose.dev.yml).
# Secret thật của SIT/Prod nằm trong Password Manager và .env trên máy chủ — không commit.
# Mọi PR thêm biến mới phải cập nhật file này (rủi ro R6 — 05-tech-spec §9).
# =============================================================================

# --- Toàn hệ thống ------------------------------------------------------------
STACK=dev
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=debug
APP_BASE_URL=http://localhost:5173
PORT=3000

# --- PostgreSQL ---------------------------------------------------------------
# Runtime (api, worker) dùng role NOBYPASSRLS; migration dùng role owner.
DATABASE_URL=postgres://angia_dev_app:angia_dev_app_local@localhost:5432/angia_dev
DATABASE_OWNER_URL=postgres://angia_dev:angia_dev_owner_local@localhost:5432/angia_dev

# --- Garage S3 ----------------------------------------------------------------
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=angia-dev
# Key dev cố định, được `yarn dev:storage-init` nhập vào Garage cục bộ.
S3_ACCESS_KEY_ID=GK0a1ce0de0a1ce0de0a1ce0de
S3_SECRET_ACCESS_KEY=0a1ce0de0a1ce0de0a1ce0de0a1ce0de0a1ce0de0a1ce0de0a1ce0de0a1ce0de
S3_FORCE_PATH_STYLE=true

# --- Authentik OIDC (dùng từ Epic 2 — app `angia-dev`) ------------------------
OIDC_ISSUER_URL=https://auth.toniboy.io.vn/application/o/angia-dev/
OIDC_CLIENT_ID=angia-dev
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
# Sinh bằng: openssl rand -base64 48
SESSION_COOKIE_SECRET=
ADMIN_GROUP_NAME=angia-admins
DEV_ADMIN_OIDC_SUBJECT=

# --- OCR: run mode độc lập provider/model chọn trong Admin (SPEC-041) ---
# Dev để fake để không gọi mạng; live dùng cấu hình DB mỗi lượt, Woku thật chưa bật ở CP4.
AI_RUN_MODE=fake
# Biến cũ: chỉ suy ra fake/live khi chưa đặt AI_RUN_MODE; không chọn provider nữa.
# AI_PROVIDER=fake
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Model chính/dự phòng được cấu hình trong Admin; worker không dùng AI_*_MODEL.
# BR-018 (E3-S6-T1): trần khởi tạo khi extraction_spend chưa có tháng nào (API + worker, phải trùng nhau);
# Trần các tháng sau do Quản trị viên chỉnh tại /admin. CP5.4 chặn theo phí thực + coverage.
AI_DEFAULT_MONTHLY_CAP_USD=5.00
# Tương thích cấu hình cũ; CP5.4 không dùng số này để giữ tiền hoặc cấp lượt.
AI_ESTIMATED_COST_USD=0.02
# Tương thích API/hồ sơ tiền cũ; CP5.4 không dùng trần USD gia đình để chặn OCR.
# Quota lượt được Admin cấp hàng tháng qua /admin, không tự quy đổi từ USD.
AI_DEFAULT_FAMILY_MONTHLY_CAP_USD=0.50
# BR-044/SPEC-032 (nợ #22): worker quét 03:00 giờ VN, xóa object S3 không còn được tham chiếu và cũ hơn
# ân hạn (giờ); trần số object xóa mỗi lần; DRY_RUN=true chỉ đếm và ghi log (lần chạy đầu trên SIT).
ORPHAN_OBJECT_GRACE_HOURS=24
ORPHAN_OBJECT_MAX_DELETES=500
ORPHAN_OBJECT_DRY_RUN=false
# BR-045/SPEC-033 (F06): worker đồng bộ phiên với Authentik mỗi 5 phút (thu hồi phiên tài khoản bị khóa/gỡ
# nhóm truy cập, đồng bộ is_system_admin theo ADMIN_GROUP_NAME ở trên). Bắt buộc ở SIT/Prod; dev để trống
# AUTHENTIK_API_TOKEN = tắt job. Token của service account angia-<env>-sync (không superuser, chỉ view_group +
# view_user — Setup §5.1.1). Vượt IDP_SYNC_MAX_REVOKES thu hồi/lượt thì không thu hồi ai; DRY_RUN=true chỉ đếm.
AUTHENTIK_URL=https://auth.toniboy.io.vn
AUTHENTIK_API_TOKEN=
# Nhóm truy cập của môi trường: angia-sit-users (dev/SIT), angia-prod-users (Prod) — không để mặc định kẻo Prod trỏ nhầm nhóm SIT.
IDP_ACCESS_GROUP_NAME=
IDP_SYNC_MAX_REVOKES=10
IDP_SYNC_DRY_RUN=false

# --- Quota tài nguyên theo gia đình (F03b, SPEC-030, BR-043) — chỉ API -----------
# Dung lượng ảnh gốc (byte), số ảnh tải/ngày giờ VN, số chứng từ chờ worker mỗi gia đình;
# số thao tác nặng (tải lô, tạo bản kiểm tra, xác nhận gửi AI) mỗi phút trên từng thao tác của một tài khoản.
QUOTA_FAMILY_STORAGE_BYTES=2147483648
QUOTA_FAMILY_DAILY_UPLOADS=100
QUOTA_FAMILY_PENDING_JOBS=10
RATE_LIMIT_HEAVY_PER_MINUTE=10

# --- Dọn tệp tạm upload mồ côi (F08b, nợ #21) — chỉ API -----------------------
# Lúc khởi động, API xóa thư mục angia-upload-* trong TMPDIR của cùng uid có mtime cũ hơn số phút này
# (thư mục mới hơn có thể thuộc request đang chạy ở tiến trình khác dùng chung /tmp).
UPLOAD_ORPHAN_GRACE_MINUTES=15

# --- Đo NFR-3 (`yarn ops:ocr-latency`, E7-S1-T2) -------------------------------
# Chuỗi kết nối role app của môi trường cần đo (vd. SIT qua tunnel); script chỉ đọc bảng job pg-boss.
OCR_LATENCY_DATABASE_URL=

# --- Đối soát lời nhắc 7 ngày (`yarn ops:reminder-audit`, E9-S3-T3/TC-096) -------
# Chuỗi kết nối role app của môi trường cần đo; script đặt phiên chỉ đọc, đọc từng gia đình qua RLS.
REMINDER_AUDIT_DATABASE_URL=

# --- Web Push (E8-S1-T2, E9-S2-T2) ---------------------------------------------------
# API (gửi thử) và worker (gửi lời nhắc) dùng chung bộ này; worker sit/prod bắt buộc đủ, dev để trống = tắt job.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# --- Chỉ dành cho docker-compose.dev.yml -------------------------------------
DEV_POSTGRES_PORT=5432
DEV_POSTGRES_OWNER_PASSWORD=angia_dev_owner_local
DEV_POSTGRES_APP_PASSWORD=angia_dev_app_local
DEV_GARAGE_S3_PORT=3900
# 32 byte hex, chỉ dùng cho Garage cục bộ.
DEV_GARAGE_RPC_SECRET=0a1ce0de0a1ce0de0a1ce0de0a1ce0de0a1ce0de0a1ce0de0a1ce0de0a1ce0de

# CP5.2: nguồn credential AnGia riêng; UUID ổn định, không đổi key dưới cùng UUID.
# JSON [{"id":"<uuid>","provider":"woku|openrouter","apiKey":"<key>"}]; không dùng key quản trị.
# Danh sách không rỗng phải bao phủ OPENROUTER_API_KEY đang cấu hình, kể cả AI_RUN_MODE=fake.
# [] tắt thu thập phí cho triển khai chưa cấu hình nguồn.
# Đồng bộ 60 giây, HTTP 20 giây, lease 120 giây, dữ liệu mới tối đa 180 giây.
AI_BILLING_SOURCES_JSON=[]

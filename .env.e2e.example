# Tooling Playwright riêng; không nạp vào cấu hình runtime API/worker/web.
E2E_BASE_URL=https://angia-sit.toniboy.io.vn
# UUID gia đình thử RIÊNG, xác nhận từ /api/me sau khi đăng nhập.
E2E_FAMILY_ID=
E2E_STORAGE_STATE=.playwright/auth/sit.json
# JPEG máy đo huyết áp thật, chỉ có số đo, không có định danh.
E2E_READING_JPEG=
# Tệp JSON: { "systolic": 120, "diastolic": 80, "pulse": 70 }
E2E_READING_EXPECTED=

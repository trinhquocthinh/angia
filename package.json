{
  "name": "angia",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "yarn build:contracts && concurrently -n contracts,api,worker,web \"yarn workspace @angia/contracts dev\" \"yarn workspace @angia/api dev\" \"yarn workspace @angia/worker dev\" \"yarn workspace @angia/web dev\"",
    "build": "yarn workspaces foreach -At --exclude angia run build",
    "build:contracts": "yarn workspace @angia/contracts build && yarn workspace @angia/web-push build",
    "typecheck": "yarn build:contracts && yarn workspaces foreach -A --exclude angia run typecheck && tsc -p tsconfig.tooling.json",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project \"unit*\"",
    "test:int": "vitest run --project \"int*\"",
    "test:perf": "vitest run --project perf-db --silent=false --reporter=verbose",
    "test:coverage": "vitest run --project \"unit*\" --coverage",
    "dup": "jscpd",
    "knip": "knip && knip --production",
    "generate:api": "yarn build:contracts && yarn workspace @angia/api generate:openapi && yarn workspace @angia/web generate:api",
    "check:api": "yarn generate:api && git diff --exit-code -- packages/contracts/openapi.json apps/web/src/shared/api/",
    "verify:fast": "yarn typecheck && vitest run --project \"unit*\" --changed",
    "verify": "yarn generate:api && yarn typecheck && yarn lint && yarn format:check && yarn test && yarn dup && yarn knip && yarn build && yarn perf:budget && yarn model:check",
    "dev:infra": "docker compose -f docker-compose.dev.yml --project-directory . up -d --wait && yarn dev:storage-init",
    "dev:storage-init": "bash scripts/dev/garage-init.sh",
    "db:generate": "yarn workspace @angia/api db:generate",
    "db:migrate": "yarn workspace @angia/api db:migrate",
    "ai:golden": "tsx --env-file=.env scripts/ai-golden/runGolden.ts",
    "heic:spike": "tsx scripts/heic-spike/runHeicSpike.ts",
    "identity:spike": "tsx scripts/spike/identityProvider.ts",
    "identity:spike:measure": "tsx scripts/spike/identityMeasurements.ts",
    "heic:spike:docker": "bash scripts/heic-spike/runInDocker.sh",
    "perf:budget": "tsx scripts/perf/checkBundleBudget.ts",
    "model:optimize": "tsx scripts/model/modelOptimize.ts",
    "model:check": "tsx scripts/model/modelCheck.ts",
    "ops:ocr-latency": "tsx --env-file-if-exists=.env scripts/ops/measureOcrLatency.ts",
    "ops:reminder-audit": "tsx --env-file-if-exists=.env scripts/ops/auditReminders.ts",
    "postinstall": "husky",
    "test:e2e": "node --env-file-if-exists=.env.e2e node_modules/@playwright/test/cli.js test",
    "e2e:auth": "node --env-file-if-exists=.env.e2e node_modules/@playwright/test/cli.js codegen --save-storage=.playwright/auth/sit.json https://angia-sit.toniboy.io.vn",
    "test:e2e:body-map": "playwright test --config playwright.body-map.config.ts",
    "test:e2e:self-pain": "yarn workspace @angia/web build && playwright test --config playwright.self-pain.config.ts",
    "test:e2e:a11y": "yarn workspace @angia/web build && playwright test --config playwright.a11y.config.ts",
    "test:lighthouse": "yarn workspace @angia/web build && lhci autorun"
  },
  "devDependencies": {
    "@angia/contracts": "workspace:*",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "9.39.5",
    "@gltf-transform/cli": "4.5.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@types/heic-convert": "2.1.1",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "heic-convert": "2.1.0",
    "heic-decode": "2.1.0",
    "husky": "9.1.7",
    "jscpd": "5.3.2",
    "knip": "6.38.0",
    "lint-staged": "17.5.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "zod": "4.6.7"
  },
  "resolutions": {
    "@tanstack/router-core/seroval": "1.6.11",
    "concurrently/shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "@esbuild-kit/core-utils/esbuild": "0.25.12"
  }
}

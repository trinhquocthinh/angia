{
  "name": "@angia/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/worker.ts",
    "build": "tsc -b tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "tsc-alias": "1.9.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

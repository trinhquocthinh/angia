+++ b/lib/find-build-files.js
@@ -0,0 +1,23 @@
+'use strict'
+
+const { glob: findPaths } = require('tinyglobby')
+const { stat } = require('node:fs/promises')
+const path = require('node:path')
+
+async function glob (pattern, options = {}) {
+  if (pattern !== 'build/*.sln' && pattern !== 'build/*.mk') {
+    throw new Error('Unsupported node-gyp build-file pattern')
+  }
+  const matches = await findPaths(pattern, { ...options, nodir: true })
+  const files = await Promise.all(matches.map(async file => {
+    try {
+      return (await stat(path.resolve(options.cwd || process.cwd(), file))).isFile() ? file : null
+    } catch (error) {
+      if (error.code === 'ENOENT' || error.code === 'ENOTDIR') return null
+      throw error
+    }
+  }))
+  return files.filter(file => file !== null).sort()
+}
+
+module.exports = { glob }

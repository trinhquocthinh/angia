{
  "openapi": "3.1.0",
  "info": {
    "title": "An Gia API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "invitationToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "storage": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          }
        },
        "required": [
          "status",
          "db",
          "storage"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "MeContextResponse": {
        "type": "object",
        "properties": {
          "account": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "displayName": {
                "type": "string"
              },
              "isSystemAdmin": {
                "type": "boolean"
              },
              "healthProfileId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              }
            },
            "required": [
              "id",
              "displayName",
              "isSystemAdmin",
              "healthProfileId"
            ]
          },
          "family": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "main",
              "member",
              null
            ]
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "account",
          "family",
          "role",
          "csrfToken"
        ]
      },
      "Family": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt"
        ]
      },
      "CreateFamilyRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "name"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "isSystemAdmin": {
            "type": "boolean"
          },
          "familyId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "main",
              "member",
              null
            ]
          }
        },
        "required": [
          "id",
          "displayName",
          "isSystemAdmin",
          "familyId",
          "role"
        ]
      },
      "AssignMembershipRequest": {
        "type": "object",
        "properties": {
          "familyId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "main",
              "member"
            ]
          }
        },
        "required": [
          "familyId",
          "role"
        ]
      },
      "ChangeMembershipRequest": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "change_role"
                ]
              },
              "role": {
                "type": "string",
                "enum": [
                  "main",
                  "member"
                ]
              }
            },
            "required": [
              "action",
              "role"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "remove"
                ]
              }
            },
            "required": [
              "action"
            ]
          }
        ]
      },
      "HealthProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "familyId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "birthYear": {
            "type": [
              "integer",
              "null"
            ]
          },
          "consentConfirmedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "consentConfirmedBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "consentBasis": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "self",
              "guardian",
              null
            ]
          },
          "consentStatus": {
            "type": "string",
            "enum": [
              "pending",
              "invited",
              "declined",
              "confirmed"
            ]
          },
          "consentSource": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "legacy_attestation",
              "invitation",
              null
            ]
          },
          "consentRespondentName": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "familyId",
          "displayName",
          "birthYear",
          "consentConfirmedAt",
          "consentConfirmedBy",
          "consentBasis",
          "consentStatus",
          "consentSource",
          "consentRespondentName",
          "createdAt"
        ]
      },
      "LinkableAccount": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName"
        ]
      },
      "CreateHealthProfileRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "birthYear": {
            "type": "integer",
            "minimum": 1900
          },
          "linkedAccountId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "displayName"
        ]
      },
      "ConfirmConsentRequest": {
        "type": "object",
        "properties": {
          "confirmedBy": {
            "type": "string",
            "enum": [
              "self",
              "guardian"
            ]
          }
        },
        "required": [
          "confirmedBy"
        ]
      },
      "UploadBatchResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceDocument"
            }
          },
          "rejectedFiles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fileName": {
                  "type": "string"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "ERR_UNSUPPORTED_FILE",
                    "ERR_FILE_TOO_LARGE"
                  ]
                }
              },
              "required": [
                "fileName",
                "code"
              ]
            }
          }
        },
        "required": [
          "id",
          "documents",
          "rejectedFiles"
        ]
      },
      "SourceDocument": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "healthProfileId": {
            "type": "string",
            "format": "uuid"
          },
          "batchId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "prescription",
              "lab_result",
              "device_reading",
              null
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "uploaded",
              "extracting",
              "pending_review",
              "approved",
              "rejected",
              "manual_entry",
              "awaiting_budget"
            ]
          },
          "documentDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "mimeType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "healthProfileId",
          "batchId",
          "type",
          "status",
          "documentDate",
          "mimeType",
          "sizeBytes",
          "createdAt"
        ]
      },
      "UploadBatchRequest": {
        "type": "object",
        "properties": {
          "files": {
            "anyOf": [
              {
                "type": "string",
                "format": "binary"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "binary"
                }
              }
            ]
          },
          "declaredType": {
            "type": "string",
            "enum": [
              "prescription",
              "lab_result",
              "device_reading"
            ]
          }
        },
        "required": [
          "files"
        ]
      },
      "ConsentInvitationCreated": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "token",
          "expiresAt"
        ]
      },
      "ConsentInvitationRevoked": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ConsentInvitationView": {
        "type": "object",
        "properties": {
          "profileDisplayName": {
            "type": "string"
          },
          "inviterDisplayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "declined"
            ]
          }
        },
        "required": [
          "profileDisplayName",
          "inviterDisplayName",
          "expiresAt",
          "status"
        ]
      },
      "ConsentInvitationReceipt": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "recorded",
              "already_responded"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "accepted",
              "declined"
            ]
          },
          "respondentName": {
            "type": "string"
          },
          "basis": {
            "type": "string",
            "enum": [
              "self",
              "guardian"
            ]
          },
          "respondedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "outcome",
          "decision",
          "respondentName",
          "basis",
          "respondedAt"
        ]
      },
      "ConsentInvitationRespondRequest": {
        "type": "object",
        "properties": {
          "respondentName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "basis": {
            "type": "string",
            "enum": [
              "self",
              "guardian"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "accepted",
              "declined"
            ]
          }
        },
        "required": [
          "respondentName",
          "basis",
          "decision"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Kiểm tra sức khỏe hệ thống (DB + storage)",
        "responses": {
          "200": {
            "description": "Mọi phụ thuộc hoạt động",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Ít nhất một phụ thuộc không phản hồi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Chuyển hướng sang Authentik (OIDC Code + PKCE S256)",
        "responses": {
          "302": {
            "description": "Chuyển hướng"
          }
        }
      }
    },
    "/api/auth/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Nhận code từ Authentik, tạo phiên và đặt cookie angia_session",
        "responses": {
          "302": {
            "description": "Chuyển hướng"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Hủy phiên hiện hành (cần X-CSRF-Token)",
        "responses": {
          "204": {
            "description": "Đã xóa phiên và cookie angia_session"
          },
          "401": {
            "description": "ERR_UNAUTHENTICATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: thiếu hoặc sai X-CSRF-Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Ngữ cảnh tài khoản, nhóm, vai trò và CSRF token của phiên hiện hành",
        "responses": {
          "200": {
            "description": "Phiên còn hạn; family/role null khi tài khoản chờ gán nhóm",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeContextResponse"
                }
              }
            }
          },
          "401": {
            "description": "ERR_UNAUTHENTICATED: thiếu phiên, phiên hết hạn hoặc cookie không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/families": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Danh sách nhóm gia đình",
        "responses": {
          "200": {
            "description": "Mọi nhóm, cũ nhất trước",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Family"
                  }
                }
              }
            }
          },
          "401": {
            "description": "ERR_UNAUTHENTICATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: không phải Quản trị hệ thống hoặc thiếu/sai X-CSRF-Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Khởi tạo nhóm gia đình mới (SPEC-001)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFamilyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Nhóm mới, chưa có tài khoản nào",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Family"
                }
              }
            }
          },
          "401": {
            "description": "ERR_UNAUTHENTICATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: không phải Quản trị hệ thống hoặc thiếu/sai X-CSRF-Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "ERR_VALIDATION: tên rỗng hoặc dài hơn 60 ký tự",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/accounts": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Danh sách tài khoản kèm nhóm và vai trò, gồm tài khoản chờ gán nhóm",
        "responses": {
          "200": {
            "description": "Mọi tài khoản, cũ nhất trước",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                }
              }
            }
          },
          "401": {
            "description": "ERR_UNAUTHENTICATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: không phải Quản trị hệ thống hoặc thiếu/sai X-CSRF-Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/accounts/{id}/membership": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Phân bổ tài khoản vào nhóm và vai trò (SPEC-002)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignMembershipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tài khoản sau khi gán",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "ERR_UNAUTHENTICATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "ERR_FORBIDDEN: không phải Quản trị hệ thống hoặc thiếu/sai X-CSRF-Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "ERR_NOT_FOUND: tài khoản hoặc nhóm không tồn tại",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "ERR_ACCOUNT_ALREADY_IN_FAMILY | ERR_FIRST_ACCOUNT_MUST_BE_MAIN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "ERR_VALIDATION",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "admin"
        ],
        "summary": "Điều chỉnh vai trò hoặc gỡ tài khoản khỏi nhóm (SPEC-003)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeMembershipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tài khoản sau thay đổi; gỡ khỏi nhóm thì familyId/role null (chờ gán nhóm)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "ERR_UNAUTHENTICATED",
            "content": {
              "application/json": {
                "schema": {
